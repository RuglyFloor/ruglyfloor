{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Coupon code (e.g., FAMILY20)"
    },
    "description": {
      "type": "string",
      "description": "Description of the coupon"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "default": "percentage",
      "description": "Type of discount"
    },
    "discount_value": {
      "type": "number",
      "description": "Discount amount (percentage or dollar amount)"
    },
    "min_order_amount": {
      "type": "number",
      "description": "Minimum order amount required",
      "default": 0
    },
    "max_uses": {
      "type": "number",
      "description": "Maximum number of times this code can be used (null = unlimited)"
    },
    "times_used": {
      "type": "number",
      "description": "Number of times this code has been used",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiration date/time"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the coupon is currently active"
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}