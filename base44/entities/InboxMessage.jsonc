{
  "name": "InboxMessage",
  "type": "object",
  "properties": {
    "from_name": {
      "type": "string",
      "description": "Sender's name"
    },
    "from_email": {
      "type": "string",
      "description": "Sender's email"
    },
    "from_phone": {
      "type": "string",
      "description": "Sender's phone (optional)"
    },
    "subject": {
      "type": "string",
      "description": "Message subject"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "status": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "archived"
      ],
      "default": "unread",
      "description": "Message status"
    },
    "replied": {
      "type": "boolean",
      "default": false,
      "description": "Whether admin has replied"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes"
    }
  },
  "required": [
    "from_email",
    "message"
  ]
}